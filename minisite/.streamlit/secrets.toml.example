# Copy this file to .streamlit/secrets.toml locally, or paste the same keys
# into Streamlit Community Cloud → App settings → Secrets (TOML format).
# Do NOT commit the real file — it is git-ignored.

# ── Claude API ────────────────────────────────────────────────────────────
# Get from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY = "sk-ant-..."

# ── Stripe ────────────────────────────────────────────────────────────────
# Secret key (for server-side payment verification) — NOT the publishable key.
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY = "sk_live_..."   # use sk_test_... while testing

# Three Payment Links, one per tier. Create each in the Stripe dashboard:
#   https://dashboard.stripe.com/payment-links
#
# For each Payment Link:
#   Amount      = 79 / 129 / 199 THB
#   After payment → "Don't show confirmation page, redirect to..."
#   Redirect URL = https://<your-app>.streamlit.app/?paid=1&tier=core&session_id={CHECKOUT_SESSION_ID}
#                                                                ^^^^  (core | yearly | full — one per link)
STRIPE_PAYMENT_LINK_CORE   = "https://buy.stripe.com/...CORE..."
STRIPE_PAYMENT_LINK_YEARLY = "https://buy.stripe.com/...YEARLY..."
STRIPE_PAYMENT_LINK_FULL   = "https://buy.stripe.com/...FULL..."
