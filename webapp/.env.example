# ── Payment (PromptPay) ───────────────────────────────────────────────
# Your personal PromptPay number: the phone number (e.g. 0812345678) or
# 13-digit national ID registered to PromptPay at your Thai bank.
# Personal accounts work — this generates a standard P2P transfer QR.
PROMPTPAY_TARGET=0812345678
# Unlock prices in THB
# Reading: ONE payment unlocks all 4 premium sections at once.
# Compat: ONE payment unlocks the entire written analysis.
UNLOCK_PRICE_THB=49
UNLOCK_COMPAT_PRICE_THB=89
# Amulet (ยันต์/부적) pack: 3 credits; reading=1, compat=2
AMULET_PACK_PRICE_THB=129

# ── Admin (payment confirmation) ──────────────────────────────────────
# Secret for /api/admin/confirm — after you see the PromptPay credit in your
# bank app, open:
#   https://<your-site>/api/admin/confirm?kind=reading&id=<ref>&key=<ADMIN_SECRET>
# (kind=compat for couple readings). Unset = confirmations disabled.
ADMIN_SECRET=

# ── Claude rewrite (optional — templates work without it) ─────────────
# Get one at https://console.anthropic.com → API keys
ANTHROPIC_API_KEY=

# ── Persistence (optional — falls back to in-memory for dev) ──────────
# Supabase project → Settings → API. Tables:
#   readings(id uuid pk, created_at timestamptz, input jsonb, chart jsonb,
#            sections jsonb, paid bool)
#   compat_readings(id uuid pk, created_at timestamptz, charts jsonb,
#            result jsonb, paid bool)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Links ─────────────────────────────────────────────────────────────
# Instagram handle (no @). The DM buttons build the official direct-message
# deep link https://ig.me/m/<handle>, which opens a chat straight to you.
NEXT_PUBLIC_IG_HANDLE=duangsaju
