# Claude API
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-6

# Instagram Graph API (publisher)
# Get from Meta for Developers → your app → Instagram Graph API
IG_ACCESS_TOKEN=
IG_USER_ID=
FB_PAGE_ID=

# Collector (optional: instaloader session for rate limits)
# Leave empty for anonymous scraping
IG_COLLECTOR_USERNAME=
IG_COLLECTOR_SESSION_FILE=

# Telegram alerts (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
